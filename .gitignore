# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
.eggs/
.venv/
venv/

# Environment
.env
.env.local

# TLS 证书与私钥（只放目标机 /opt/www/certs，绝不入库）
certs/

# IDE
.idea/

# 本地 AI 工具的个人配置（模型/密钥等，不入库）
.codebuddy/models.json
# .claude/mcp.json 可能含明文 API Key，且不是任何工具的读取路径（生效的是
# <项目根>/.mcp.json 与 ~/.codebuddy/.mcp.json），一律不入库
.claude/mcp.json

# Generated indices (auto-regeneratable)
.coverage
.superpowers/
.superprojects/

# understand-anything：图谱与指纹入库共享，中间态/回收站不入库
# （官方建议：提交 .ua/ 但排除 intermediate/ 与 diff-overlay.json）
.ua/.trash-*/
.ua/tmp/
.ua/intermediate/

# Docker volume data
/data/

# Logs
logs/
*.log

# 本地开发（scripts/dev-worktree.sh）：端口记录与本地后端 pid
.dev-ports
.dev-uvicorn.pid

# 构建期暂存目录（scripts/ci/pack-deploy-artifact.sh 的产物，供流水线的 ArtifactUpload 取用）
/pack-staging/

# OS
.DS_Store
Thumbs.db

# Playwright CLI artifacts
.playwright-cli/

# Firecrawl CLI artifacts（多 URL 抓取时会落盘）
.firecrawl/

# DeepEval 运行时产物（每次评测在 CWD 落 .latest_run_full.json / .latest_test_run.json）
.deepeval/

# 评测证据产物（--evidence / --evidence-all 写出的逐题 JSON 与 summary）
data/deepeval/evidence/
