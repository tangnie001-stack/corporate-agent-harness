# 环境变量清单（仅键名，不含任何真值）
# 复制为 .env 后填入真实值。以下键为必填，缺失会导致启动或 compose 校验失败：
#   POSTGRES_PASSWORD   —— 应用库账号密码；compose 里用 ${POSTGRES_PASSWORD:?} 强制要求
#   REDIS_PASSWORD
#   DASHSCOPE_API_KEY
#   LANGFUSE_POSTGRES_PASS
#   LANGFUSE_INIT_PROJECT_ID / _PUBLIC_KEY / _SECRET_KEY
#                       —— Langfuse 空库首次启动的播种开关；缺 _ID 则 project 与 key 都不建，
#                          且不报错（UI 无可用凭据）。_PUBLIC_KEY / _SECRET_KEY 须与
#                          LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY 是同一对
#   LANGFUSE_INIT_USER_EMAIL / _PASSWORD
#                       —— 管理员账号；缺任一则不建用户，UI 无法登录

AUTH_TOKEN_TTL=
CHUNK_EVAL_ENABLED=
CHUNK_OVERLAP=
CHUNK_SIZE=
# 分类角色模型：可选覆盖（不填 → registry.models[classify] 默认）
CLASSIFY_MODEL=
# 分类角色 provider：可选，缺省跟随 LLM_PROVIDER（见 design D4）
CLASSIFY_PROVIDER=
COMPOSE_PROFILES=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# 切 DeepSeek 时填真实 key（与 LLM_PROVIDER/RAGAS_PROVIDER=deepseek 配合）
DEEPSEEK_API_KEY=
# embedding 模型：可选覆盖（不填 → registry.models[embedding] 默认）
EMBEDDING_MODEL=
# embedding provider：可选，缺省独立为 dashscope，不跟随 LLM_PROVIDER（见 design D4）
EMBEDDING_PROVIDER=
FASTAPI_HOST=
FASTAPI_PORT=
LANGFUSE_ENABLE=true
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_HOST=
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_POSTGRES_PASS=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SALT=
LANGFUSE_SECRET_KEY=
LITELLM_MASTER_KEY=
# ⚠ Phase 1 软迁移保留（deprecated，Phase 2 删除）；改用 <PROVIDER>_API_KEY
LLM_API_KEY=
# ⚠ Phase 1 软迁移保留（deprecated，Phase 2 删除）；改用 <PROVIDER>_BASE_URL
LLM_BASE_URL=
# 主角色模型：可选覆盖（不填 → registry.models[main] 默认）
LLM_MODEL=
# 主角色 provider 指针：main/classify/summary 缺省跟随此值；
# embedding/rerank/judge 独立缺省 dashscope（见 design D4）
LLM_PROVIDER=
LLM_TEMPERATURE=
MAX_FILE_SIZE=
MEMORY_WINDOW=
# MinIO：MINIO_ACCESS_KEY / MINIO_SECRET_KEY 同时被 minio 服务端与应用侧使用
# （compose 里服务端的 MINIO_ROOT_USER/PASSWORD 直接引用这两个键，同源），无需另配 MINIO_ROOT_*
MINIO_ACCESS_KEY=
MINIO_DOC_BUCKET=
MINIO_ENDPOINT=
MINIO_SECRET_KEY=
# 模型定价（Langfuse 成本计算）已迁入 registry.yaml 的 catalog.pricing（单位：单个 token）
NEXTAUTH_SECRET=
NEXTAUTH_URL=
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_PORT=
POSTGRES_USER=
# RAGAS 裁判模型：可选覆盖（不填 → registry.models[judge] 默认）
RAGAS_LLM_MODEL=
# RAGAS 裁判 provider：可选，缺省独立为 dashscope，不跟随 LLM_PROVIDER（见 design D4）
RAGAS_PROVIDER=
REDIS_DB=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=
REDIS_TTL=
REDIS_USERNAME=
# 重排序模型：可选覆盖（不填 → registry.models[rerank] 默认）
RERANK_MODEL=
# rerank provider：可选，缺省独立为 dashscope，不跟随 LLM_PROVIDER（见 design D4）
RERANK_PROVIDER=
RETRY_BACKOFF_FACTOR=
RETRY_INITIAL_INTERVAL=
RETRY_MAX_ATTEMPTS=
# 跨轮摘要模型：可选覆盖（不填 → registry.models[summary] 默认，即跟随 main）
SUMMARY_MODEL=
# 摘要角色 provider：可选，缺省跟随 LLM_PROVIDER（见 design D4）
SUMMARY_PROVIDER=
TAVILY_API_KEY=
# Langfuse 遥测上报开关；compose 兜底为 false（不降级，但 deploy.sh 的 .env 完整性校验要求它显式出现）
TELEMETRY_ENABLED=false
TEST_ACCOUNT=
TEST_PASSWORD=
TOP_K_RERANK=
TOP_K_RETRIEVAL=

# ── 企业微信智能机器人（多机器人长连接）──
# 启用通道（关闭时回调端点 404、不解析 WECOM_BOTS）
# ⚠ 生产由 docker-compose.image.yml 的 environment 强制为 true；本地保持 false 以免误连踢号
WECOM_BOT_ENABLED=false
# 接入方式：long_connection（多机器人长连接）| callback（URL 回调，legacy 单机器人）
WECOM_BOT_MODE=long_connection
# 多机器人配置：JSON 数组，★必须写在一行★（多行会导致解析失败）
#   每台：key=业务线标识（[a-z0-9_-]，唯一，不得用保留字 callback）
#         bot_id=智能机器人 BotID（= 入站报文的 aibotid）
#         secret=长连接专用 Secret
# 示例（占位值，勿直接使用）：
# WECOM_BOTS=[{"key":"dev","bot_id":"<BotID>","secret":"<Secret>"},{"key":"support","bot_id":"<BotID>","secret":"<Secret>"}]
WECOM_BOTS=
# 是否打印用户消息正文（默认关，防泄露）
WECOM_BOT_LOG_CONTENT=false
# ── 以下仅 WECOM_BOT_MODE=callback（legacy）使用 ──
WECOM_BOT_TOKEN=
WECOM_BOT_ENCODING_AES_KEY=
WECOM_BOT_RECEIVE_ID=
# ⚠ 长连接：每机器人同时只允许一条连接，新连接会踢掉旧连接 ——
#   多实例部署时，仅在一台实例开启 WECOM_BOT_ENABLED=true，其余置 false

# ── 阿里云告警接入（alibaba-alert-notify） ──
# 接收端点鉴权 token（请求头 X-Alert-Token）。空 = 未启用，端点恒 404。
ALERT_WEBHOOK_TOKEN=
# 目标群（单目标 JSON）：bot_key 复用 WECOM_BOTS 里的 key；chatid 从 sessions.title 读出
ALERT_TARGET=
# 入口去重时间窗（秒）与容量上限
ALERT_DEDUP_WINDOW_SECONDS=300
ALERT_DEDUP_CAPACITY=4096
# 整轮分析超时（秒）与兜底消息长度上限
ALERT_TURN_TIMEOUT_SECONDS=240
ALERT_FALLBACK_MAX_CHARS=1500
